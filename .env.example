# ==============================================================================
# SlotCare Environment Variables Configuration
# Copy this file to .env.local and populate with your Supabase Project Settings
# ==============================================================================

# 1. Supabase Project URL & Anon/Public API Key
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. Supabase Service Role Key (Backend Only - NEVER expose to browser)
# Used for administrative operations and database seeding
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
